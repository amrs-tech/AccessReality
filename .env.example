# All values are server-only. Fill secrets locally, never commit them.
SERPAPI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEMO_ACCESS_CODE=
ADMIN_API_SECRET=
SESSION_HMAC_SECRET=
RATE_LIMIT_HMAC_SECRET=
APP_ORIGIN=http://localhost:3000
SEARCH_ENABLED=false
# Real-provider verification runs share a durable 30-search allocation.
VERIFICATION_MODE=false
SERPAPI_PROTECTED_RESERVE=30
SERPAPI_OPERATIONAL_CAP=220
SERPAPI_DAILY_ATTEMPT_CAP=60
SERPAPI_SESSION_ATTEMPT_CAP=64
# Above 50 verified remaining credits: finite full evidence menu (at most 26).
# At 50 or fewer, or no fresh account check: at most 5 investigation searches.
INVESTIGATION_SEARCH_CAP=26
INVESTIGATION_LLM_CAP=56
MAX_WORKFLOW_STEPS=128
# Optional release metadata; not a credential.
APP_COMMIT_SHA=
